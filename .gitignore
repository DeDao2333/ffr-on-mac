*.ucas
*.utoc
*.uasset
*.uexp
romfs/
exefs/

# Keys and saves
*.keys
*.sav
GameSaveData*
/save/
/save.work/

# Build products (the app contains the game)
*.app/
*.ipa
*.patched.bin
*_build/
*_survey/
/work/
/tools/split_xci/bin/
/tools/split_xci/obj/

# Local diagnostics: screenshots show the game, logs carry local paths
*.noindex/
/*.log
/*.png

# Python and macOS
.venv/
__pycache__/
.DS_Store
